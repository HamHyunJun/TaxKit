# Nuxt 빌드 산출물
.output
.data
.nuxt
.nitro
.cache
dist

# 의존성
node_modules

# 로그
logs
*.log

# 기타
.DS_Store
.fleet
.idea
.vscode/*
!.vscode/extensions.json

# 로컬 환경 변수
.env
.env.*
!.env.example

# pnpm 외 다른 패키지 매니저 lock 파일 (pnpm만 사용)
package-lock.json
yarn.lock

# 실제 고객 엑셀 데이터 커밋 방지 (익명화 샘플은 test/fixtures에만)
*.xlsx
*.xls
*.csv
!test/fixtures/**

# Vercel CLI가 만드는 프로젝트 연결 정보
.vercel

# OMC 에이전트 작업 상태(세션·훅 기록)는 커밋하지 않는다
.omc/
